# ─────────────────────────────────────────────
#  SmartStock  –  Environment Configuration
#  Copy this file to .env and fill in values.
#  NEVER commit the real .env to version control.
# ─────────────────────────────────────────────

# MongoDB connection URI
# Local:   mongodb://localhost:27017/
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017/

# Database name
MONGO_DB_NAME=smartstock

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-string

# Flask environment  (development | production)
FLASK_ENV=development

# Application host and port
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ─── Store configuration ───────────────────────
STORE_NAME=SmartStock Electronics
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL=₹
STORE_TAX_PERCENT=18
STORE_INVOICE_PREFIX=INV
STORE_LOW_STOCK_DEFAULT=5

# ─── Security ──────────────────────────────────
# Session lifetime in minutes
SESSION_LIFETIME_MINUTES=120
BCRYPT_LOG_ROUNDS=12
